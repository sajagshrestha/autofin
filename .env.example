# ── Public (client) ────────────────────────────────────────────
VITE_APP_TITLE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server: Supabase (used by server functions too) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database (Drizzle / postgres.js) ───────────────────────────
DATABASE_URL=

# ── Gmail OAuth ────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must point at this app's callback route:
GMAIL_OAUTH_REDIRECT_URI=

# ── AI (OpenAI by default; see src/server/lib/ai.ts) ───────────
AI_PROVIDER=openai
OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Optional integrations ──────────────────────────────────────
DISCORD_WEBHOOK_URL=
# GMAIL_PUBSUB_VERIFICATION_TOKEN=
# GMAIL_WATCH_RESYNC_INTERVAL=

# ── Optional integrations ──────────────────────────────────────
# EXTRA_ALLOWED_ORIGINS=http://localhost:5173
# Secret used to sign per-user MCP tokens (rotating invalidates all)
# MCP_TOKEN_SECRET=
