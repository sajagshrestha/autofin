# ── Public (client) ────────────────────────────────────────────
VITE_APP_TITLE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── PostHog (client analytics) ─────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Server: Supabase (used by server functions too) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database (Drizzle / postgres.js) ───────────────────────────
DATABASE_URL=

# ── Gmail OAuth ────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must point at this app's callback route:
GMAIL_OAUTH_REDIRECT_URI=

# ── AI (OpenAI by default; see src/server/lib/ai.ts) ───────────
AI_PROVIDER=openai
OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Optional integrations ──────────────────────────────────────
DISCORD_WEBHOOK_URL=
# GMAIL_PUBSUB_VERIFICATION_TOKEN=
# GMAIL_WATCH_RESYNC_INTERVAL=

# ── Web Push (PWA notifications) ────────────────────────────────
# Generate a keypair with `npx web-push generate-vapid-keys`. The public key
# is also exposed to the browser (VITE_ prefixed); the private key is server-only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact (mailto:) required by browser push services:
VAPID_SUBJECT=mailto:sajagshrestha0852@gmail.com

# ── Optional integrations ──────────────────────────────────────
# EXTRA_ALLOWED_ORIGINS=http://localhost:5173
# Secret used to sign per-user MCP tokens (rotating invalidates all)
# MCP_TOKEN_SECRET=
